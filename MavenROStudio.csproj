<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>4.2.1</Version>
    <AssemblyName>MavenROStudio</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />

    <Compile Update="Studio.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Studio.Designer.cs">
      <DependentUpon>Studio.cs</DependentUpon>
    </Compile>

    <Compile Update="ItemInspectorPage.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="ItemInspectorPage.Designer.cs"><DependentUpon>ItemInspectorPage.cs</DependentUpon></Compile>
    <Compile Update="GrfExplorerPage.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="GrfExplorerPage.Designer.cs"><DependentUpon>GrfExplorerPage.cs</DependentUpon></Compile>
    <Compile Update="ItemEditorControl.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="ItemEditorControl.Designer.cs"><DependentUpon>ItemEditorControl.cs</DependentUpon></Compile>
    <Compile Update="YamlEditorControl.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="YamlEditorControl.Designer.cs"><DependentUpon>YamlEditorControl.cs</DependentUpon></Compile>
    <Compile Update="BarterEditorControl.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="BarterEditorControl.Designer.cs"><DependentUpon>BarterEditorControl.cs</DependentUpon></Compile>
    <Compile Update="NpcEditorControl.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="NpcEditorControl.Designer.cs"><DependentUpon>NpcEditorControl.cs</DependentUpon></Compile>
    <Compile Update="PetEditorControl.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="PetEditorControl.Designer.cs"><DependentUpon>PetEditorControl.cs</DependentUpon></Compile>
    <Compile Update="ProjectValidatorControl.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="ProjectValidatorControl.Designer.cs"><DependentUpon>ProjectValidatorControl.cs</DependentUpon></Compile>
    <Compile Update="DataSourcesPage.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="DataSourcesPage.Designer.cs"><DependentUpon>DataSourcesPage.cs</DependentUpon></Compile>
    <Compile Update="DiagnosticsPage.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="DiagnosticsPage.Designer.cs"><DependentUpon>DiagnosticsPage.cs</DependentUpon></Compile>

    <None Include="config.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="README.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="ROADMAP.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="HOT_WEEK_BARTER_V2.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="DESIGNER_GUIDE.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>